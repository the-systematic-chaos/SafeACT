# --- GitHub App ---------------------------------------------------------
GITHUB_APP_ID=123456
# Either a path to the .pem file GitHub gave you...
GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem
# ...or the PEM text itself, with newlines written as \n
# GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- Which workflows ----------------------------------------------------------
# Only runs that are, or call, these workflows are counted, limited and logged.
# Comma-separated owner/repo/.github/workflows/file.yml, * allowed. Unset = every workflow.
TARGET_WORKFLOWS=acme/central/.github/workflows/build.yml

# --- Policy ---------------------------------------------------------------
# Jobs each person can have queued or running at once, across the org.
MAX_JOBS_PER_USER=5
# Per-person exceptions, login=limit separated by commas.
# USER_LIMITS=release-captain=20,renovate[bot]=3
# soft: check each run once, when it starts. hard: check every job.
MODE=soft
# Leave on until the logs look right. Nothing is cancelled while this is true.
DRY_RUN=true
# Post a "Job limit" check on the commit explaining a cancellation (needs Checks: write).
EXPLAIN_WITH_CHECK_RUN=true
# Bots (Dependabot, Renovate, github-actions...) aren't limited unless they're in USER_LIMITS.
EXEMPT_BOTS=true
# People who are never limited.
# EXEMPT_ACTORS=release-captain
# Triggers that are never limited. Nobody starts a scheduled run, so it isn't charged to a person.
EXEMPT_EVENTS=schedule

# --- Run log --------------------------------------------------------------
# Who ran what, from which repo and branch, and when. Set to empty to turn it off.
RUN_LOG_FILE=./data/runs.jsonl
# Turns on GET /runs and GET /active. At least 16 characters, e.g. from: openssl rand -hex 32
ADMIN_TOKEN=

# --- Operations -------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# Re-check jobs and runs not heard about for STALE_AFTER_SECONDS, every SWEEP_INTERVAL_SECONDS.
SWEEP_INTERVAL_SECONDS=300
STALE_AFTER_SECONDS=900
# For GitHub Enterprise Server: https://HOSTNAME/api/v3 (and you may need GITHUB_API_VERSION=2022-11-28)
# GITHUB_API_URL=https://api.github.com
# GITHUB_API_VERSION=2026-03-10
